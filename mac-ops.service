[Unit]
Description=Maytag Admin Console (MAC) - Infrastructure Management Platform
Documentation=file:///opt/mac-ops/DEPLOYMENT.md
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=macops
Group=macops
WorkingDirectory=/opt/mac-ops

# Start the Flask/SocketIO server
ExecStart=/home/macops/.venv/bin/python /opt/mac-ops/backend/app.py

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=600
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mac-ops

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

# Timeout for graceful shutdown
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
